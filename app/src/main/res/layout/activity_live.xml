<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:shutter_background_color="#000000" />

    <!-- Top bar: camera name, LIVE pill, timer -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="32dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/live_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="WAKING"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cam_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:shadowColor="#000000"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="monospace"
            android:shadowColor="#000000"
            android:shadowRadius="6" />
    </LinearLayout>

    <!-- Bottom hint -->
    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="56dp"
        android:paddingBottom="32dp"
        android:textColor="#DDFFFFFF"
        android:textSize="17sp"
        android:shadowColor="#000000"
        android:shadowRadius="6" />

    <!-- Loader -->
    <LinearLayout
        android:id="@+id/loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/loader_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loader_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="720dp"
            android:gravity="center"
            android:textColor="@color/ink_dim"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Error -->
    <LinearLayout
        android:id="@+id/error_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/card_bg"
        android:padding="36dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Couldn't open the camera"
            android:textColor="@color/live"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxWidth="720dp"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="OK  retry      ◀ ▶  other camera      BACK  grid"
            android:textColor="@color/ink_dim"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
